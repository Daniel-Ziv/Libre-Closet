# Copy this file to .env.production. Never commit .env.production.
DOMAIN=your-subdomain.duckdns.org
APP_NAME=Libre Closet

# Keep authentication and PWA support enabled for an Internet-facing install.
AUTH_ENABLED=true
PWA_ENABLED=true
SUPPORTER_PROMPT_ENABLED=false

# Leave registration enabled only until the first account is created, then set
# this to true and run ./deploy.sh again.
DISABLE_REGISTRATION=false

# ./deploy.sh replaces this placeholder with a cryptographically random value.
ACCESS_TOKEN_SECRET=GENERATE_ME
